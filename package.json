{
  "name": "mern-architecture",
  "version": "1.0.0",
  "description": "MERN Stack Monorepo - Shared modules, Auth, and E-Commerce projects",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./auth.client dev",
    "build": "pnpm --filter ./shared-ui build",
    "lint": "pnpm --filter ./auth.client lint",
    "typecheck": "pnpm --filter ./auth.client typecheck",
    "dev:api": "pnpm --filter ./auth.server start",
    "start": "pnpm --filter ./auth.client dev",
    "start:api": "pnpm --filter ./auth.server start"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
